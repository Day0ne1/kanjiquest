# Cloudflare Pages & Netlify Cache-Control headers for optimized asset delivery

# Static assets with hash in filename (immutable caching for 1 year)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Root HTML documents (always revalidate to ensure immediate updates on redeploy)
/*
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
